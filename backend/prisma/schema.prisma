generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  BUY
  SELL
}

enum Exchange {
  BURSA // Bursa Malaysia (.KL)
  US    // NYSE / NASDAQ
}

enum Currency {
  MYR
  USD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portfolios    Portfolio[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Portfolio {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  baseCurrency Currency @default(MYR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  holdings     Holding[]
  transactions Transaction[]
  snapshots    PortfolioSnapshot[]

  @@index([userId])
}

model Holding {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol      String    // e.g. "1155.KL" or "AAPL"
  exchange    Exchange
  currency    Currency
  quantity    Decimal   @db.Decimal(18, 6)
  avgCost     Decimal   @db.Decimal(18, 6)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([portfolioId, symbol])
  @@index([symbol])
}

model Transaction {
  id          String           @id @default(cuid())
  portfolioId String
  portfolio   Portfolio        @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  symbol      String
  type        TransactionType
  quantity    Decimal          @db.Decimal(18, 6)
  price       Decimal          @db.Decimal(18, 6)
  currency    Currency
  fee         Decimal          @db.Decimal(18, 6) @default(0)
  date        DateTime
  createdAt   DateTime         @default(now())

  @@index([portfolioId, date])
  @@index([symbol])
}

// Daily price cache (filled by the cron job from yahoo-finance2)
model DailyPrice {
  id       String   @id @default(cuid())
  symbol   String
  date     DateTime @db.Date
  open     Decimal  @db.Decimal(18, 6)
  high     Decimal  @db.Decimal(18, 6)
  low      Decimal  @db.Decimal(18, 6)
  close    Decimal  @db.Decimal(18, 6)
  volume   BigInt
  currency Currency

  @@unique([symbol, date])
  @@index([symbol, date])
}

// Daily portfolio value snapshot (used for Sharpe / Volatility / Drawdown)
model PortfolioSnapshot {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  totalValue  Decimal   @db.Decimal(18, 6) // in the portfolio's baseCurrency
  totalCost   Decimal   @db.Decimal(18, 6)
  // Cash dividends going ex on this date, in base currency. NAV drops by this
  // amount on the ex-date, so the return calculation has to add it back.
  dividendIncome Decimal @db.Decimal(18, 6) @default(0)
  createdAt   DateTime  @default(now())

  @@unique([portfolioId, date])
  @@index([portfolioId, date])
}

// Yahoo returns OHLC already adjusted for splits, so a new split silently
// rebases the whole history. We store splits to re-express pre-split trades
// in post-split terms, and to detect when stored prices went stale.
model StockSplit {
  id          String   @id @default(cuid())
  symbol      String
  date        DateTime @db.Date
  numerator   Int // 4 for a 4:1 split
  denominator Int // 1 for a 4:1 split

  @@unique([symbol, date])
  @@index([symbol, date])
}

// Cash dividends. Yahoo `close` is not dividend adjusted, so without these
// every return in the app is a price return and understates performance.
model Dividend {
  id       String   @id @default(cuid())
  symbol   String
  exDate   DateTime @db.Date
  amount   Decimal  @db.Decimal(18, 6) // per share, in the symbol's own currency
  currency Currency

  @@unique([symbol, exDate])
  @@index([symbol, exDate])
}

// Yahoo only serves today's options chain, so implied vol history has to be
// built here, one row per US symbol per session. After the daily sync the
// front-month at-the-money straddle is recorded; IV rank reads this table.
model ImpliedSnapshot {
  id           String   @id @default(cuid())
  symbol       String
  date         DateTime @db.Date // US session the marks belong to
  expiry       DateTime @db.Date
  spot         Decimal  @db.Decimal(18, 6)
  strike       Decimal  @db.Decimal(18, 6)
  atmIv        Decimal  @db.Decimal(12, 8) // mean of the ATM call and put IV, annualized
  straddleMove Decimal  @db.Decimal(12, 8) // (call mid + put mid) / spot
  createdAt    DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol, date])
}

// One row per full sync. The daily cron lives in the API process, so a laptop
// that was asleep at 6:30am misses the run; startup reads this to catch up.
model SyncRun {
  id         String    @id @default(cuid())
  trigger    String // cron | manual | startup | script
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  error      String?

  @@index([ok, finishedAt])
}

// One row per agent per month-end pass of the orchestrator. A failed agent
// leaves ok = false with its error; the other agents still run.
model AgentRun {
  id           String    @id @default(cuid())
  agent        String // technical | risk
  asOf         DateTime  @db.Date // month-end session the forecasts are made at
  trigger      String // cron | manual | startup | script
  modelVersion String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  ok           Boolean   @default(false)
  error        String?
  rows         Int       @default(0)

  forecasts AgentForecast[]

  @@index([agent, asOf])
}

// Live record of what each agent said at a month end, written before the
// outcome is known. Rows are only ever inserted, never updated.
model AgentForecast {
  id           String   @id @default(cuid())
  runId        String
  run          AgentRun @relation(fields: [runId], references: [id])
  agent        String
  symbol       String
  asOf         DateTime @db.Date
  horizon      String // 1m
  target       String // returnScore | vol
  value        Decimal  @db.Decimal(18, 10)
  modelVersion String
  createdAt    DateTime @default(now())

  @@unique([agent, symbol, asOf, horizon, target])
  @@index([agent, asOf])
}

// Yahoo serves current headlines only, so the sync records them forward for
// the Sentiment agent. One headline can be filed under several symbols.
model NewsHeadline {
  id         String   @id @default(cuid())
  symbol     String
  sourceId   String // Yahoo uuid
  published  DateTime
  title      String
  publisher  String
  link       String?
  recordedAt DateTime @default(now())

  @@unique([symbol, sourceId])
  @@index([symbol, published])
}

// Ken French daily factors, stored as fractions (the files publish percent).
// US only. Refreshed from the data library; the tail lags by about a month.
model FactorReturn {
  date   DateTime @db.Date
  factor String // Mkt-RF, SMB, HML, RMW, CMA, Mom, RF
  value  Decimal  @db.Decimal(16, 10)

  @@id([date, factor])
  @@index([factor, date])
}

// Benchmark index for Beta & Alpha (e.g. ^KLSE for Bursa, ^GSPC for US)
model BenchmarkPrice {
  id     String   @id @default(cuid())
  symbol String   // "^KLSE" or "^GSPC"
  date   DateTime @db.Date
  close  Decimal  @db.Decimal(18, 6)

  @@unique([symbol, date])
  @@index([symbol, date])
}

// FX rate used to convert USD holdings to MYR (base currency) in snapshots
model ExchangeRate {
  id     String   @id @default(cuid())
  from   Currency
  to     Currency
  date   DateTime @db.Date
  rate   Decimal  @db.Decimal(18, 8)

  @@unique([from, to, date])
}