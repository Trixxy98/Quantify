# Copy this file to ".env" and fill in real values. Do not commit ".env".

# PostgreSQL connection string (the ?schema= suffix from the Prisma days is accepted and ignored)
DATABASE_URL="postgresql://quantify:quantify@localhost:5434/quantify"

# Server
API_PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Daily 6:30am MYT sync plus a catch-up on startup. Only one process may own it.
SCHEDULER_ENABLED=true

# JWT Auth (at least 32 characters each)
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Optional
# RISK_FREE_RATE=0.03
# FRED_API_KEY=
